[Unit]
Description=SPHERE PROD calendar report background precompute (snapshots only)
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/sphere/rundeck-prod.env

[Service]
Type=oneshot
User=sphere
Group=sphere
WorkingDirectory=/opt/sphere-rundeck-prod/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SPHERE_REPORT_SNAPSHOT_PROD_WORKER=true
Environment="PGOPTIONS=-c default_transaction_read_only=on"
Environment=SPHERE_REPORT_SNAPSHOT_DIR=/var/lib/sphere/report-snapshots-prod
EnvironmentFile=/etc/sphere/rundeck-prod.env
ExecStart=/opt/sphere-rundeck-prod/venv/bin/python -m backend.rundeck_prod_report_precompute
StateDirectory=sphere/report-snapshots-prod
StateDirectoryMode=0750
TimeoutStartSec=600
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sphere/report-snapshots-prod
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=10.14.55.205/32
