# DEV ONLY: never copy into PROD. Protect as root:sphere-jumphost (0640).
JUMPHOST_ENV=dev
JUMPHOST_PUBLIC_BASE_PATH=/dev/jumphost
JUMPHOST_AUTH_DB=/var/lib/sphere-jumphost-dev/auth.sqlite3
# One-time DEV bootstrap only; admin/admin is forced to change on first login.
JUMPHOST_DEV_BOOTSTRAP_ADMIN_ADMIN=1
# Behind valid HTTPS use 1. Set 0 only for isolated localhost HTTP QA.
JUMPHOST_COOKIE_SECURE=1
